/**
 * Pull the design tokens out of akaVST.
 *
 * Socket has to draw in the same language as the instruments it composes, and a
 * copied palette is one that will be wrong within a month — which is the whole
 * reason akaVST generates its tokens rather than writing them by hand.
 *
 * Reads the JSON that akaVST's own generator emits, so there is exactly one
 * source for the site, the plugins and this. Output is committed, so a clone
 * without akaVST beside it still builds and still looks right; it just cannot
 * pick up changes until someone runs this next to a checkout.
 *
 *   pnpm sync:tokens
 */

import fs from "node:fs";
import path from "node:path";

const ROOT = path.resolve(import.meta.dirname, "..");
const SOURCE = path.resolve(ROOT, "..", "akaVST", "web", "src", "content", "tokens.generated.json");
const OUT = path.join(ROOT, "src", "styles.css");

if (!fs.existsSync(SOURCE)) {
  console.error(`✗ no akaVST checkout beside this one — expected ${SOURCE}`);
  console.error("  the committed styles.css still works; this only refreshes it.");
  process.exit(1);
}

type Theme = { name: string; scheme: string; css: Record<string, string> };
const tokens = JSON.parse(fs.readFileSync(SOURCE, "utf-8")) as {
  radii: Record<string, string>;
  themes: Theme[];
};

const block = (selector: string, theme: Theme, radii: boolean) =>
  [
    `${selector} {`,
    `  color-scheme: ${theme.scheme};`,
    ...Object.entries(theme.css).map(([k, v]) => `  ${k}: ${v};`),
    ...(radii ? Object.entries(tokens.radii).map(([k, v]) => `  --${k}: ${v};`) : []),
    "}",
  ].join("\n");

const dark = tokens.themes.find((t) => t.scheme === "dark")!;
const light = tokens.themes.find((t) => t.scheme === "light")!;

fs.writeFileSync(
  OUT,
  `/* Generated by pnpm sync:tokens from akaVST. Do not edit. */

${block(":root", light, true)}

${block(".dark", dark, false)}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--background);
  color: var(--foreground);
  font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* Mono for structure, sans for prose — the house rule. */
.label {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.6875rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--muted-foreground);
}

.app { display: flex; flex-direction: column; height: 100vh; }

/* Depth is a hairline, never a shadow. */
.chrome {
  display: flex;
  align-items: baseline;
  gap: 1rem;
  padding: 1.25rem 1.5rem;
  border-bottom: 1px solid var(--hairline);
  -webkit-app-region: drag;
  padding-left: 5.5rem;
}

.wordmark { font-size: 1.05rem; font-weight: 300; letter-spacing: 0.02em; }

main { flex: 1; overflow: auto; padding: 1.5rem; }

.card {
  border: 1px solid var(--card-border);
  border-radius: var(--radius-card);
  background: var(--card-alpha);
  padding: 1rem 1.15rem;
}

.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 0.75rem; }

.dot { width: 6px; height: 6px; border-radius: 999px; display: inline-block; }
`,
);

console.log(`✓ ${path.relative(ROOT, OUT)}`);
